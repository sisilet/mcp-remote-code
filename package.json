{
  "name": "mcp-remote-code",
  "version": "1.2.0",
  "description": "MCP server for remote machine control over SSH - exposes remote tools as additional capabilities alongside local tools",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-remote-code": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/postbuild.mjs",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "ssh2": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "mcp",
    "ssh",
    "remote",
    "agent",
    "opencode"
  ],
  "license": "MIT"
}
