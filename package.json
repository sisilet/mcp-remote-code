{
  "name": "mcp-remote-code",
  "version": "3.2.0",
  "description": "Stdio MCP server for remote machine control over SSH with a jailed root directory",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-remote-code": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/postbuild.mjs",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit && npm run lint:stdout",
    "test": "node --import tsx --test test/*.test.ts test/tools/*.test.ts",
    "test:docker": "npm run test:docker:down --silent; node --import tsx --test --test-concurrency=1 test/docker/*.test.ts; rc=$?; npm run test:docker:down --silent; exit $rc",
    "test:docker:down": "docker compose -f test/docker/compose.yml down -v >/dev/null 2>&1 || true",
    "lint:stdout": "! grep -rn 'console\\.log' src/ --include=*.ts | grep -v 'index.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "diff": "^9.0.0",
    "ssh2": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "mcp",
    "ssh",
    "remote",
    "agent",
    "stdio"
  ],
  "license": "MIT"
}
